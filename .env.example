# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (it holds secrets); this .env.example is committed as documentation.

# Vercel AI Gateway API key — funds the agent's model calls ("the brain").
# Get one: Vercel dashboard -> AI Gateway -> API Keys. Needs a paid/topped-up account;
# the free tier returns 403 "Free tier users do not have access to this model" for premium models.
# This is the exact variable name the Eve / AI SDK reads (NOT VERCEL_API_GATEWAY_KEY).
AI_GATEWAY_API_KEY=

# Auto-created by `eve link` (Vercel OIDC token). Short-lived; re-run `eve link` to refresh.
# Acts as a fallback AI Gateway credential; AI_GATEWAY_API_KEY takes precedence when set.
VERCEL_OIDC_TOKEN=

# --- Slack ---
# Slack is wired through Vercel Connect (a managed Slack app), so there is no
# SLACK_BOT_TOKEN or SLACK_SIGNING_SECRET to paste — Connect mints the bot token,
# authenticated by VERCEL_OIDC_TOKEN above.

# Vercel Connect connector holding the workspace's Slack install.
# Read by agent/channels/slack.ts and agent/tools/post_as_villager.ts.
# Defaults to "slack/it-takes-a-village" when unset.
SLACK_CONNECTOR=

# Slack workspace (team) id, e.g. T0123456789. A tool's execute() runs outside
# every Slack handler and so has no access to the inbound event's team, which is
# why this has to be configured rather than inferred. post_as_villager falls back
# to the hackathon workspace id when unset; a second workspace MUST set this.
SLACK_TEAM_ID=

# Exa
# EXA_API_KEY= 
# --- Memory permanence (ADR 0003) ---
# Vercel Blob store token — the live memory store. Auto-pulled by `vercel env pull`
# after `vercel blob store add`. Must also be set in the Vercel Production env.
BLOB_READ_WRITE_TOKEN=

# GitHub token for the snapshot_memory tool (commits the readable memory folder to
# a non-deploying branch via the Git Data API). Fine-grained, repo-scoped, Contents:rw.
# App env only — NEVER commit a real value.
GITHUB_TOKEN=
GITHUB_REPO=davehague/it-takes-a-village
GITHUB_MEMORY_BRANCH=village-memory
